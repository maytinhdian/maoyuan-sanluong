<UserControl x:Class="DisplayBoard.App.Views.Displays.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DisplayBoard.App.Controls"
             xmlns:s="clr-namespace:DisplayBoard.App.Views.Shared"
             Width="1920" Height="1080">
    <Grid Background="{StaticResource BoardBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <s:DisplayHeader />
        <!-- Cột Ca co về 0 khi không có dữ liệu ca (SharedSizeGroup lấy độ rộng lớn nhất). -->
        <StackPanel Grid.Row="1" Margin="40,24,40,0" Grid.IsSharedSizeScope="True">
            <Border Background="{StaticResource TableHeaderBackground}" CornerRadius="10,10,0,0" Padding="20,0">
                <Grid Height="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="250" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Shift" /><ColumnDefinition Width="220" /><ColumnDefinition Width="220" />
                        <ColumnDefinition Width="160" /><ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mã NV" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Column="1" Text="Họ tên" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Column="2" Text="Bộ phận" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Column="3" Text="Ca" Style="{StaticResource TableHeaderText}" Width="120" TextAlignment="Center"
                               Visibility="{Binding HasShift, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Grid.Column="4" Text="Sản lượng" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Right" Margin="0,0,24,0" />
                    <TextBlock Grid.Column="5" Text="Mục tiêu" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Right" Margin="0,0,24,0" />
                    <TextBlock Grid.Column="6" Text="%" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Right" Margin="0,0,24,0" />
                    <TextBlock Grid.Column="7" Text="Trạng thái" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" />
                </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Padding="20,0">
                            <Grid Height="72">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shift" /><ColumnDefinition Width="220" /><ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Code}" Style="{StaticResource TableCellText}" FontSize="32" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TableCellText}" FontSize="32" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{Binding Department}" Style="{StaticResource TableCellText}" FontSize="32" />
                                <TextBlock Grid.Column="3" Text="{Binding Shift}" Style="{StaticResource TableCellText}" FontSize="32" Width="120" TextAlignment="Center"
                                           Visibility="{Binding Shift, Converter={StaticResource NullToVisibility}}" />
                                <TextBlock Grid.Column="4" Text="{Binding Quantity}" Style="{StaticResource TableCellText}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,24,0" />
                                <TextBlock Grid.Column="5" Text="{Binding Target}" Style="{StaticResource TableCellText}" FontSize="32" HorizontalAlignment="Right" Margin="0,0,24,0" />
                                <TextBlock Grid.Column="6" Text="{Binding Rate}" Style="{StaticResource TableCellText}" FontSize="32" HorizontalAlignment="Right" Margin="0,0,24,0" />
                                <Border Grid.Column="7" Style="{StaticResource StatusPill}" Margin="24,10" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=table}">
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource TableCellText}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAlternate}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource TableRowAlt}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding PageText}" Style="{StaticResource BoardText}" FontSize="30" Foreground="{StaticResource TextSecondary}"
                   HorizontalAlignment="Right" Margin="0,0,50,24"
                   Visibility="{Binding PageText, Converter={StaticResource NullToVisibility}}" />
    </Grid>
</UserControl>
