<UserControl x:Class="DisplayBoard.App.Views.Displays.TopProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DisplayBoard.App.Controls"
             xmlns:s="clr-namespace:DisplayBoard.App.Views.Shared"
             Width="1920" Height="1080">
    <Grid Background="#0B2A1C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <s:DisplayHeader HeaderBackground="#0F3A26" IconBrush="{StaticResource MetBrush}" />
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Top}" Margin="30,40">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="14" CornerRadius="18" Background="{StaticResource SuccessCard}" BorderBrush="#1F7A4A" BorderThickness="2" Padding="20,30">
                        <StackPanel>
                            <Grid Height="90">
                                <c:Icon x:Name="Crown" Kind="crown" Width="90" Height="80" Fill="{StaticResource NearBrush}" />
                                <TextBlock x:Name="RankNumber" Text="{Binding Rank}" Style="{StaticResource BoardText}" FontSize="64" FontWeight="Bold"
                                           HorizontalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <!-- Ảnh sản phẩm nếu có, không có thì khối màu ghi mã sản phẩm -->
                            <Border Width="240" Height="240" Margin="0,16" CornerRadius="24" Background="{Binding Color, Converter={StaticResource HexToBrush}}" ClipToBounds="True">
                                <Grid>
                                    <Viewbox Margin="20" StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding Code}" Style="{StaticResource BoardText}" FontSize="72" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="200" TextTrimming="None" />
                                    </Viewbox>
                                    <Image Source="{Binding ImagePath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"
                                           Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibility}}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BoardText}" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding DailyActual}" Style="{StaticResource BoardText}" FontSize="92" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                            <TextBlock Text="{Binding DailyRate}" Style="{StaticResource BoardText}" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{Binding DailyStatus, Converter={StaticResource StatusBrush}, ConverterParameter=text}" />
                            <TextBlock Text="{Binding DailyVariance}" Style="{StaticResource BoardText}" FontSize="36" HorizontalAlignment="Center"
                                       Foreground="{Binding DailyVarianceNegative, Converter={StaticResource StatusBrush}}" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsTop3}" Value="False">
                            <Setter TargetName="Crown" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RankNumber" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
