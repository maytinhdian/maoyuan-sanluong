<UserControl x:Class="DisplayBoard.App.Views.Displays.TrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DisplayBoard.App.Controls"
             xmlns:s="clr-namespace:DisplayBoard.App.Views.Shared"
             Width="1920" Height="1080">
    <Grid Background="{StaticResource BoardBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <s:DisplayHeader />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Rectangle Width="60" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource BoardText}" Margin="16,0,60,0"><Run Text="Thực hiện: " /><Run Text="{Binding TotalQuantity, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
            <Line X1="0" X2="60" Y1="4" Y2="4" Stroke="#F472B6" StrokeThickness="6" StrokeDashArray="2 1.5" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource BoardText}" Margin="16,0,60,0"><Run Text="Mục tiêu: " /><Run Text="{Binding TotalTarget, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
            <TextBlock Style="{StaticResource BoardText}"><Run Text="Hoàn thành: " /><Run Text="{Binding CompletionText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource MetBrush}" /></TextBlock>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="40,24,40,40">
            <Grid>
                <c:TrendChart Points="{Binding Points}" Visibility="{Binding HasData, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="Chưa có dữ liệu theo giờ" Style="{StaticResource BoardText}" FontSize="56" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasData, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
