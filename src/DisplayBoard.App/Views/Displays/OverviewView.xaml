<UserControl x:Class="DisplayBoard.App.Views.Displays.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DisplayBoard.App.Controls"
             xmlns:s="clr-namespace:DisplayBoard.App.Views.Shared"
             Width="1920" Height="1080">
    <Grid Background="{StaticResource BoardBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="400" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <s:DisplayHeader />

        <Grid Grid.Row="1" Margin="40,36,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,20,0" Background="#154A8A">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="TỔNG SẢN LƯỢNG" Style="{StaticResource CardTitle}" FontSize="38" HorizontalAlignment="Center" Foreground="White" />
                    <TextBlock Text="{Binding TotalQuantity}" Style="{StaticResource KpiValue}" FontSize="150" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Unit}" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="MỤC TIÊU" Style="{StaticResource CardTitle}" FontSize="38" HorizontalAlignment="Center" Foreground="White" />
                    <TextBlock Text="{Binding TotalTarget}" Style="{StaticResource KpiValue}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Unit}" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="20,0,0,0" Background="#0E3A2A" BorderBrush="#1C6B45">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="HOÀN THÀNH" Style="{StaticResource CardTitle}" FontSize="38" HorizontalAlignment="Center" Foreground="White" />
                    <Grid Grid.Row="1" Width="250" Height="250" Margin="0,10,0,0">
                        <c:ProgressRing Value="{Binding CompletionRate}" Thickness="26" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding CompletionText}" Style="{StaticResource BoardText}" FontSize="72" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="40,36,40,40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding MetSummary}" Style="{StaticResource CardTitle}" FontWeight="Normal" />
                    <TextBlock Text="SẢN LƯỢNG THEO BỘ PHẬN" Style="{StaticResource CardTitle}" Foreground="White" />
                </DockPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Departments}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="30,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="1" Text="{Binding Quantity}" Style="{StaticResource BoardText}" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <Border Grid.Row="2" Height="{Binding BarHeight}" CornerRadius="10,10,0,0" Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                <TextBlock Grid.Row="3" Text="{Binding Name}" Style="{StaticResource BoardText}" FontSize="34" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
