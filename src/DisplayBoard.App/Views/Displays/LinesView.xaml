<UserControl x:Class="DisplayBoard.App.Views.Displays.LinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DisplayBoard.App.Controls"
             xmlns:s="clr-namespace:DisplayBoard.App.Views.Shared"
             Width="1920" Height="1080">
    <Grid Background="{StaticResource BoardBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <s:DisplayHeader />
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}" Margin="28,24,28,28">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 Rows="{Binding DataContext.Rows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="12" CornerRadius="18" Padding="36,24" Background="{StaticResource CardBackground}"
                            BorderBrush="{Binding DailyStatus, Converter={StaticResource StatusBrush}}" BorderThickness="0,0,0,10">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                            <StackPanel Width="520">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DailyRate}" Style="{StaticResource BoardText}" FontSize="64" FontWeight="Bold"
                                               Foreground="{Binding DailyStatus, Converter={StaticResource StatusBrush}, ConverterParameter=text}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BoardText}" FontSize="48" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding DailyActual}" Style="{StaticResource BoardText}" FontSize="80" FontWeight="Bold" />
                                    <TextBlock Style="{StaticResource BoardText}" FontSize="40" VerticalAlignment="Bottom" Margin="14,0,0,12" Foreground="{StaticResource TextSecondary}">
                                        <Run Text="/" /><Run Text="{Binding DailyTarget, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <c:ProgressLine Height="30" Margin="0,8,0,0" Fraction="{Binding DailyFraction}" Fill="{Binding DailyStatus, Converter={StaticResource StatusBrush}}" />
                                <DockPanel Margin="0,14,0,0">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource BoardText}" FontSize="30"
                                               Visibility="{Binding HasMonth, Converter={StaticResource NullToVisibility}}">
                                        <Run Text="Tháng " Foreground="{StaticResource TextSecondary}" /><Run Text="{Binding MonthRate, Mode=OneWay}" FontWeight="Bold"
                                             Foreground="{Binding MonthStatus, Converter={StaticResource StatusBrush}, ConverterParameter=text}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding MetText}" Style="{StaticResource BoardText}" FontSize="30" Foreground="{StaticResource TextSecondary}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource BoardText}" FontSize="30" Margin="0,10,0,0" Foreground="{StaticResource NearBrush}"
                                           Visibility="{Binding CarriedShortfall, Converter={StaticResource NullToVisibility}}">
                                    <Run Text="Hôm trước thiếu: " /><Run Text="{Binding CarriedShortfall, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </StackPanel>
                        </Viewbox>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
