<UserControl x:Class="DisplayBoard.App.Views.Displays.ProductProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DisplayBoard.App.Controls"
             xmlns:s="clr-namespace:DisplayBoard.App.Views.Shared"
             Width="1920" Height="1080">
    <Grid Background="{StaticResource BoardBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <s:DisplayHeader />
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}" Margin="28,24,28,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 Rows="{Binding DataContext.Rows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="12" CornerRadius="18" Padding="32,20" Background="{StaticResource CardBackground}"
                            BorderBrush="{Binding DailyStatus, Converter={StaticResource StatusBrush}}" BorderThickness="0,0,0,8">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                            <StackPanel Width="520">
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Width="16" Height="44" RadiusX="4" RadiusY="4" Margin="0,0,16,0"
                                               Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BoardText}" FontSize="42" FontWeight="SemiBold" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding DailyActual}" Style="{StaticResource BoardText}" FontSize="86" FontWeight="Bold" />
                                    <TextBlock Style="{StaticResource BoardText}" FontSize="42" VerticalAlignment="Bottom" Margin="14,0,0,14" Foreground="{StaticResource TextSecondary}">
                                        <Run Text="/" /><Run Text="{Binding DailyTarget, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DailyRate}" Style="{StaticResource BoardText}" FontSize="50" FontWeight="Bold"
                                               Width="150" TextAlignment="Right" Foreground="{Binding DailyStatus, Converter={StaticResource StatusBrush}, ConverterParameter=text}" />
                                    <c:ProgressLine Height="34" Fraction="{Binding DailyFraction}" Fill="{Binding DailyStatus, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource BoardText}" FontSize="28" Margin="0,8,0,0" Foreground="{StaticResource NearBrush}"
                                           Visibility="{Binding CarriedShortfall, Converter={StaticResource NullToVisibility}}">
                                    <Run Text="Hôm trước thiếu: " /><Run Text="{Binding CarriedShortfall, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                                <DockPanel Margin="0,14,0,0" Visibility="{Binding HasMonth, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MonthRate}" Style="{StaticResource BoardText}" FontSize="32"
                                               Width="150" TextAlignment="Right" Foreground="{Binding MonthStatus, Converter={StaticResource StatusBrush}, ConverterParameter=text}" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BoardText}" FontSize="26" Foreground="{StaticResource TextSecondary}">
                                            <Run Text="Tháng: " /><Run Text="{Binding MonthCumulative, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding MonthTarget, Mode=OneWay}" />
                                        </TextBlock>
                                        <c:ProgressLine Height="14" Margin="0,6,0,0" Fraction="{Binding MonthFraction}" Fill="{Binding MonthStatus, Converter={StaticResource StatusBrush}}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Viewbox>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="2" Text="{Binding PageText}" Style="{StaticResource BoardText}" FontSize="30" Foreground="{StaticResource TextSecondary}"
                   HorizontalAlignment="Right" Margin="0,0,50,20"
                   Visibility="{Binding PageText, Converter={StaticResource NullToVisibility}}" />
    </Grid>
</UserControl>
