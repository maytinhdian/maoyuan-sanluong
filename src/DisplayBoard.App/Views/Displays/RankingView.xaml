<UserControl x:Class="DisplayBoard.App.Views.Displays.RankingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DisplayBoard.App.Controls"
             xmlns:s="clr-namespace:DisplayBoard.App.Views.Shared"
             Width="1920" Height="1080">
    <UserControl.Resources>
        <Style x:Key="Cols" TargetType="Grid">
            <Setter Property="Height" Value="74" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource BoardBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <s:DisplayHeader />
        <StackPanel Grid.Row="1" Margin="40,30,40,30">
            <Border Background="{StaticResource TableHeaderBackground}" CornerRadius="10,10,0,0" Padding="20,0">
                <Grid Height="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" /><ColumnDefinition Width="210" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" /><ColumnDefinition Width="240" /><ColumnDefinition Width="180" /><ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Mã NV" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Column="2" Text="Họ tên" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Column="3" Text="Bộ phận" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Column="4" Text="Sản lượng" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Right" Margin="0,0,30,0" />
                    <TextBlock Grid.Column="5" Text="%" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Right" Margin="0,0,30,0" />
                    <TextBlock Grid.Column="6" Text="Trạng thái" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center" />
                </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Padding="20,0" Background="Transparent">
                            <Grid Style="{StaticResource Cols}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" /><ColumnDefinition Width="210" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" /><ColumnDefinition Width="240" /><ColumnDefinition Width="180" /><ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="RankBadge" Width="56" Height="56" CornerRadius="28" Background="Transparent" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Rank}" Style="{StaticResource TableCellText}" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Code}" Style="{StaticResource TableCellText}" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource TableCellText}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="{Binding Department}" Style="{StaticResource TableCellText}" />
                                <TextBlock Grid.Column="4" Text="{Binding Quantity}" Style="{StaticResource TableCellText}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,30,0" />
                                <TextBlock Grid.Column="5" Text="{Binding Rate}" Style="{StaticResource TableCellText}" HorizontalAlignment="Right" Margin="0,0,30,0" />
                                <Border Grid.Column="6" Style="{StaticResource StatusPill}" Margin="20,10" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=table}">
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource TableCellText}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAlternate}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource TableRowAlt}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTop3}" Value="True">
                                <Setter TargetName="RankBadge" Property="Background" Value="{StaticResource NearBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
