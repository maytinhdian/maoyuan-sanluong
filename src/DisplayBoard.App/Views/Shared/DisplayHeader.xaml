<UserControl x:Class="DisplayBoard.App.Views.Shared.DisplayHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DisplayBoard.App.Controls">
    <!-- DataContext: DisplayViewModelBase -->
    <Border Background="{Binding HeaderBackground, RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="48,0" Height="130">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:Icon Kind="{Binding IconKind}" Width="64" Height="64" Fill="{Binding IconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource BoardText}" FontSize="54" FontWeight="Bold" />
                <TextBlock Text="{Binding DataDateNote}" Style="{StaticResource BoardText}" FontSize="26" Foreground="{StaticResource NearBrush}"
                           Visibility="{Binding DataDateNote, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Clock.Date}" Style="{StaticResource BoardText}" FontSize="26" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Clock.Time}" Style="{StaticResource BoardText}" FontSize="56" FontWeight="Bold" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
