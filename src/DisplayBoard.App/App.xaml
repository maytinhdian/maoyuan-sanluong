<Application x:Class="DisplayBoard.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DisplayBoard.App.Converters"
             xmlns:vm="clr-namespace:DisplayBoard.App.ViewModels.Displays"
             xmlns:d="clr-namespace:DisplayBoard.App.Views.Displays"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:StatusToBrushConverter x:Key="StatusBrush" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:PathToImageConverter x:Key="PathToImage" DecodePixelWidth="400" />
            <conv:PathToImageConverter x:Key="PathToImageLarge" DecodePixelWidth="1920" />
            <conv:FractionOfWidthConverter x:Key="FractionOfWidth" />

            <!-- ViewModel → View. Preview và fullscreen dùng chung các template này. -->
            <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><d:OverviewView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RankingViewModel}"><d:RankingView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductProgressViewModel}"><d:ProductProgressView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TopProductsViewModel}"><d:TopProductsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:NotMetViewModel}"><d:NotMetView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:NoticeViewModel}"><d:NoticeView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DetailViewModel}"><d:DetailView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MonthProgressViewModel}"><d:MonthProgressView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LinesViewModel}"><d:LinesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HourlyViewModel}"><d:HourlyView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
