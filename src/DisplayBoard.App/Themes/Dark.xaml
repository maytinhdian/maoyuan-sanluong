<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu TV: nền tối, tương phản cao, đọc được từ xa. -->
    <Color x:Key="BoardBackgroundColor">#0A1830</Color>
    <SolidColorBrush x:Key="BoardBackground" Color="{StaticResource BoardBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#0F2447" />
    <SolidColorBrush x:Key="CardBackground" Color="#12305C" />
    <SolidColorBrush x:Key="CardBorder" Color="#1F4580" />
    <SolidColorBrush x:Key="TableHeaderBackground" Color="#1A3A6B" />
    <SolidColorBrush x:Key="TableRowAlt" Color="#0F2447" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B7C6E0" />
    <SolidColorBrush x:Key="MetBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="NotMetBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="NearBrush" Color="#F5B301" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="DangerBackground" Color="#3B0F16" />
    <SolidColorBrush x:Key="DangerHeader" Color="#5A1320" />
    <SolidColorBrush x:Key="DangerCard" Color="#6B1827" />
    <SolidColorBrush x:Key="SuccessBackground" Color="#0C2E1E" />
    <SolidColorBrush x:Key="SuccessCard" Color="#114A2E" />

    <FontFamily x:Key="BoardFont">Segoe UI</FontFamily>

    <Style x:Key="BoardText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BoardFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BoardText}">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource BoardText}">
        <Setter Property="FontSize" Value="110" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="TableHeaderText" TargetType="TextBlock" BasedOn="{StaticResource BoardText}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TableCellText" TargetType="TextBlock" BasedOn="{StaticResource BoardText}">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="28" />
    </Style>

    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
