<Window x:Class="DisplayBoard.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DisplayBoard.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="Display Board"
        Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" Padding="20,14">
            <TextBlock Text="DISPLAY BOARD" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

        <!-- Sidebar: only "Trang chủ" is implemented so far. -->
        <Border DockPanel.Dock="Left" Width="170" Background="#F3F4F6" Padding="0,12">
            <StackPanel>
                <TextBlock Text="Trang chủ" Margin="20,8" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Cấu hình" Margin="20,8" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Xem trước" Margin="20,8" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Nhật ký" Margin="20,8" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Cài đặt" Margin="20,8" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>

        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Data file -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="FILE DỮ LIỆU" FontWeight="Bold" Margin="0,0,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Tải lại" Padding="14,4" Margin="8,0,0,0"
                            Command="{Binding ReloadCommand}" />
                    <Button DockPanel.Dock="Right" Content="Chọn file" Padding="14,4" Margin="8,0,0,0"
                            Command="{Binding SelectFileCommand}" />
                    <TextBox Text="{Binding ExcelFile, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="● " Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LastUpdated, StringFormat='   {0:HH:mm:ss}'}" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Summary -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,20,0,0">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Nhân viên" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Snapshot.Summary.TotalEmployees, FallbackValue='-'}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Tổng sản lượng" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Snapshot.Summary.TotalQuantity, StringFormat='{}{0:N0}', FallbackValue='-'}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Mục tiêu" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Snapshot.Summary.TotalTarget, StringFormat='{}{0:N0}', FallbackValue='-'}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="% hoàn thành" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Snapshot.Summary.CompletionRate, StringFormat='{}{0:0.#}%', FallbackValue='-'}" FontSize="26" FontWeight="Bold" />
                </StackPanel>
            </UniformGrid>

            <!-- Skipped rows -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Warnings}" Margin="0,16,0,0" MaxHeight="90">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Foreground="{StaticResource WarningBrush}">
                            <Run Text="Dòng " /><Run Text="{Binding RowNumber, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Data read from Excel, to check the reader until the TV views exist. -->
            <DataGrid Grid.Row="3" Margin="0,16,0,0" ItemsSource="{Binding Snapshot.Summary.Ranking}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hạng" Binding="{Binding Rank}" />
                    <DataGridTextColumn Header="Mã NV" Binding="{Binding EmployeeCode}" />
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding EmployeeName}" Width="*" />
                    <DataGridTextColumn Header="Bộ phận" Binding="{Binding Department}" />
                    <DataGridTextColumn Header="Sản lượng" Binding="{Binding Quantity, StringFormat='{}{0:N0}'}" />
                    <DataGridTextColumn Header="Mục tiêu" Binding="{Binding Target, StringFormat='{}{0:N0}'}" />
                    <DataGridTextColumn Header="% hoàn thành" Binding="{Binding CompletionRate, StringFormat='{}{0:0.#}%'}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
